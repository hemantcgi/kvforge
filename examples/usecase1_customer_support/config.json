{
  "_comment": "Use Case 1 — Customer Support Q&A with Qdrant",

  "collection":       "customer-support",
  "vector_store":     "qdrant",
  "qdrant_host":      "localhost",
  "qdrant_port":      6333,

  "loader":           "jsonl",
  "jsonl_text_key":   "text",
  "chunk_size":       600,
  "chunk_overlap":    60,
  "embed_batch":      64,
  "upsert_batch":     128,
  "top_k":            5,

  "embed_model":      "BAAI/bge-small-en-v1.5",
  "embedder_backend": "fastembed",
  "vector_dim":       384,

  "llm_model":        "meta-llama/Llama-3.2-3B-Instruct",
  "max_new_tokens":   256,

  "lora_rank":        16,
  "lora_alpha":       32,
  "lora_target_modules": ["q_proj", "k_proj", "v_proj"],
  "lora_dropout":     0.05,
  "lora_epochs":      3,
  "lora_lr":          0.0002,

  "checkpoint_dir":   "examples/usecase1_customer_support/lora_checkpoints/",
  "version_file":     "examples/usecase1_customer_support/version.json",
  "replay_db":        "examples/usecase1_customer_support/replay.db",

  "gate_threshold":   0.75,
  "prs_threshold":    0.75,
  "prs_weights":      {"accuracy": 0.5, "calibration": 0.3, "consistency": 0.2},

  "faq_question_key": "question",
  "faq_answer_key":   "answer",

  "dashboard_port":   8081
}
