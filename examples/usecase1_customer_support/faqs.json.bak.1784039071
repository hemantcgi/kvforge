[
  {
    "question": "How do I reset my password? (variant 0)",
    "answer": "Go to Settings > Security > Change Password, enter your current password, then choose a new password with at least 8 characters including a number and a symbol."
  },
  {
    "question": "What payment methods are accepted? (variant 1)",
    "answer": "We accept Visa, Mastercard, American Express, Discover, PayPal, and Apple Pay."
  },
  {
    "question": "How do I track my order? (variant 2)",
    "answer": "Log in to your account, navigate to Orders, and click Track Shipment next to the order you want to follow."
  },
  {
    "question": "Can I change my shipping address after ordering? (variant 3)",
    "answer": "You can change the shipping address within 30 minutes of placing the order by clicking Edit Order on the confirmation page."
  },
  {
    "question": "How do I contact support? (variant 4)",
    "answer": "You can reach support through the in-app chat, by emailing support@example.com, or by calling 1-800-555-0123."
