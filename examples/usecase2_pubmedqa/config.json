{
  "_comment": "Use Case 2 — Biomedical Q&A with ChromaDB (no Docker required)",

  "collection":           "pubmedqa",
  "vector_store":         "chroma",
  "chroma_persist_dir":   "examples/usecase2_pubmedqa/.chroma/pubmedqa",

  "loader":               "jsonl",
  "jsonl_text_key":       "text",
  "chunk_size":           600,
  "chunk_overlap":        60,
  "embed_batch":          64,
  "upsert_batch":         128,
  "top_k":                5,

  "embed_model":          "BAAI/bge-small-en-v1.5",
  "embedder_backend":     "fastembed",
  "vector_dim":           384,

  "llm_model":            "meta-llama/Llama-3.2-3B-Instruct",
  "max_new_tokens":       256,

  "lora_rank":            16,
  "lora_alpha":           32,
  "lora_target_modules":  ["q_proj", "k_proj", "v_proj"],
  "lora_dropout":         0.05,
  "lora_epochs":          3,
  "lora_lr":              0.0002,

  "checkpoint_dir":       "examples/usecase2_pubmedqa/lora_checkpoints/",
  "version_file":         "examples/usecase2_pubmedqa/version.json",
  "replay_db":            "examples/usecase2_pubmedqa/replay.db",

  "gate_threshold":       0.75,
  "prs_threshold":        0.75,
  "prs_weights":          {"accuracy": 0.5, "calibration": 0.3, "consistency": 0.2},

  "faq_question_key":     "question",
  "faq_answer_key":       "answer",

  "dashboard_port":       8082
}
